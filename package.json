{
  "name": "friends",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@12.11.2",
  "description": "YunYouJun's friends",
  "author": {
    "name": "YunYouJun",
    "email": "me@yunyoujun.cn",
    "url": "https://www.yunyoujun.cn"
  },
  "license": "MIT",
  "homepage": "https://www.yunyoujun.cn/links/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunYouJun/friends.git"
  },
  "bugs": {
    "url": "https://github.com/YunYouJun/friends/issues"
  },
  "bin": "./bin/run",
  "files": [
    "/bin",
    "/lib"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "add": "node --import tsx scripts/index.ts add",
    "check:links": "meodp check",
    "check:links:ci": "meodp check",
    "build": "npm run build:json && npm run build:status",
    "build:json": "npm run generate && npm run copy",
    "build:status": "meodp report",
    "generate": "node --import tsx scripts/generate.ts",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "notify:links": "meodp notify --channel email",
    "notify:links:feishu": "meodp notify --channel feishu",
    "copy": "cp -r ./public/. ./dist && cp README.md ./dist/",
    "update": "git add -A && git commit -m '👥 update friends' && git push",
    "typecheck": "tsc --noEmit",
    "report:links": "meodp report reports/friends/report.json --output reports/site",
    "report:links:restore": "node --import tsx scripts/restore-link-report.ts",
    "report:links:save": "node --import tsx scripts/save-link-report.ts",
    "report:links:verify": "meodp report --verify"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "chalk-pipe": "^6.2.0",
    "commander": "^15.0.0",
    "js-yaml": "^5.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^24.19.2",
    "consola": "^3.4.2",
    "eslint": "^10.12.0",
    "meodp": "^0.2.2",
    "nodemailer": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
