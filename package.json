{
  "name": "friends",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.14.0",
  "description": "YunYouJun's friends",
  "author": {
    "name": "YunYouJun",
    "email": "me@yunyoujun.cn",
    "url": "https://www.yunyoujun.cn"
  },
  "license": "MIT",
  "homepage": "https://www.yunyoujun.cn/links/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunYouJun/friends.git"
  },
  "bugs": {
    "url": "https://github.com/YunYouJun/friends/issues"
  },
  "bin": "./bin/run",
  "files": [
    "/bin",
    "/lib"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "add": "tsx scripts/index.ts add",
    "check:links": "meodp check public/links.yml --output reports/friends --history .cache/friends/local.json --fail-on none",
    "check:links:ci": "meodp check public/links.yml --output reports/friends --history .cache/friends/github-actions.json --observer github-actions-ubuntu --fail-on none",
    "build": "npm run build:json && npm run build:status",
    "build:json": "npm run generate && npm run copy",
    "build:status": "meodp report public/status/report.json --output dist/status",
    "generate": "tsx scripts/generate.ts",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "notify:links": "node scripts/notify-link-report.mjs",
    "notify:links:feishu": "node scripts/notify-feishu-report.mjs",
    "copy": "cp -r ./public/. ./dist && cp README.md ./dist/",
    "update": "git add -A && git commit -m '👥 update friends' && git push",
    "typecheck": "tsc --noEmit",
    "report:links": "meodp report reports/friends/report.json --output reports/site",
    "report:links:save": "node scripts/save-link-report.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "chalk-pipe": "^6.2.0",
    "commander": "^14.0.0",
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.1.0",
    "@types/chalk-pipe": "^2.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.1.0",
    "consola": "^3.4.2",
    "eslint": "^9.32.0",
    "meodp": "^0.1.0",
    "nodemailer": "^10.0.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
