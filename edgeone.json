{
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/status/report.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/status/report.json",
      "destination": "https://raw.githubusercontent.com/YunYouJun/friends/gh-pages/status/report.json"
    }
  ]
}
